{
  "name": "swu-collection",
  "module": "server/index.ts",
  "type": "module",
  "scripts": {
    "patreon:sync": "bun scripts/patreon/sync.ts",
    "play:browser:editors": "RICH_TEXT_EDITOR_TEST=1 bun --env-file=.env --env-file=.env.worktree frontend/tests/rich-text-editor.browser.ts",
    "play:check": "bun run --cwd play check",
    "play:demo": "bun run --cwd play demo",
    "play:archive": "bun run --cwd play archive",
    "play:archive:verify": "bun run --cwd play archive:verify",
    "play:benchmark": "bun run --cwd play benchmark",
    "play:targets": "bun play/scripts/card-targets.ts",
    "play:targets:refresh": "bun play/scripts/refresh-card-targets.ts",
    "play:coverage": "bun run --cwd play coverage",
    "play:browser:home": "bun --env-file=.env --env-file=.env.worktree play/browser/home-smoke.ts",
    "play:browser:test": "bun --env-file=.env --env-file=.env.worktree play/browser/game-smoke.ts",
    "play:serve": "bun play/worker/index.ts",
    "start": "bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "auth-generate": "auth generate --config server/auth/auth.ts",
    "mcp:start": "bun mcp/index.ts",
    "mcp:check": "tsgo --project mcp/tsconfig.json && bun test mcp",
    "db-generate": "bun drizzle-kit generate",
    "db-migrate": "bun migrate.ts",
    "db-docker": "docker run -d --name swubase-postgres -e POSTGRES_PASSWORD=password -p 5442:5432 postgres:16-alpine",
    "screenshotter": "bun server/screenshotter/runScreenshotter.ts",
    "screenshotter:tournament": "bun server/screenshotter/runTournamentScreenshots.ts",
    "screenshotter:install": "bunx playwright install chromium",
    "play:storage:test": "bun run --cwd play storage:test",
    "play:browser:gallery": "bun --env-file=.env --env-file=.env.worktree play/browser/gallery.ts",
    "play:history:benchmark": "bun --env-file=.env --env-file=.env.worktree play/scripts/history-benchmark.ts",
    "play:history:browser": "bun --env-file=.env --env-file=.env.worktree play/browser/history-smoke.ts",
    "play:cards:export": "bun play/scripts/card-release.ts export",
    "play:cards:publish": "bun --env-file=.env --env-file=.env.worktree play/scripts/card-release.ts publish",
    "play:cards:install": "bun --env-file=.env --env-file=.env.worktree play/scripts/card-release.ts install",
    "play:cards:schema": "bun play/scripts/generate-card-schema.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "^1.3.1",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.6",
    "prettier": "^3.4.2",
    "@typescript/native-preview": "^7.0.0-dev.20260216.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.920.0",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@hono/zod-validator": "^0.7.4",
    "@modelcontextprotocol/server": "2.3.1",
    "@sentry/bun": "^10.22.0",
    "better-auth": "1.7.7",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.10.3",
    "linkedom": "^0.18.12",
    "playwright": "^1.59.1",
    "postgres": "^3.4.5",
    "sharp": "^0.34.4",
    "zod": "4.6.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
