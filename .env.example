ENVIRONMENT=local
DATABASE_URL=postgresql://postgres:password@localhost:5442/postgres
# Persistent secret (at least 32 characters). Rotating also revokes calendar feed URLs.
BETTER_AUTH_SECRET=___random_string
BETTER_AUTH_URL=http://localhost:5173
VITE_BETTER_AUTH_URL=http://localhost:5173
# Optional original online game service. Worktree tooling allocates its port.
CROSSFIRE_ENABLED=0
# Optional overrides for realtime WebSocket endpoints
VITE_GAME_RESULTS_WS_URL=ws://localhost:3010/api/ws/game-results
VITE_LIVE_TOURNAMENT_WS_URL=ws://localhost:3010/api/ws/live-tournaments/:weekendId
GITHUB_CLIENT_ID=client_id_from_your_github_app
GITHUB_CLIENT_SECRET=client_secret_from_your_github_app
GOOGLE_CLIENT_ID=client_id_from_your_google_app
GOOGLE_CLIENT_SECRET=client_secret_from_your_google_app
CONTINENTL_API_KEY=(optional - api key for https://continentl.com/)
R2_ACCESS_KEY_ID=(optional - only if you want to upload images/files to your bucket)
R2_SECRET_ACCESS_KEY=(optional - like above)
R2_ENDPOINT=(optional - like above)
# User uploads use these R2 credentials in every environment, including local.
# Stored in swu-images and served directly from https://images.swubase.com.

# Required for private tournament files in swu-images. Generate a base64 key with:
# openssl rand -base64 32
# Retain this key: replacing it makes existing files unreadable.
# Files use authenticated encryption; downloads always require the owner's session.
USER_DATA_ENCRYPTION_KEY=

# Server-only contributor database backup job. Do not put real server paths in
# this committed file; set them in the .env file on the Coolify server instead.
REMOTE_DEV_R2_BUCKET=swu-images
REMOTE_DEV_RAW_BACKUP_R2_PREFIX=private/path/to/raw-postgres-backups
REMOTE_DEV_LOCAL_BACKUP_DIR=/private/path/to/coolify-backups
REMOTE_DEV_SANITIZED_R2_KEY=data/development/sanitized/swubase-clean-db.dmp
REMOTE_DEV_SANITIZED_MANIFEST_R2_KEY=data/development/sanitized/swubase-clean-db.manifest.json
# Public, read-only delivery endpoint for the already-sanitized contributor dump.
# No R2 credentials are needed by local worktrees.
REMOTE_DEV_SANITIZED_PUBLIC_BASE_URL=https://images.swubase.com
# Retain immutable public generations long enough for active worktree restores.
REMOTE_DEV_SANITIZED_RETENTION_DAYS=14
REMOTE_DEV_R2_REGION=auto
REMOTE_DEV_AWS_CLI_IMAGE=amazon/aws-cli:2
REMOTE_DEV_POSTGRES_IMAGE=postgres:16-alpine
REMOTE_DEV_SANITIZE_SQL_DIR=scripts/remote-dev/sql

TOURNAMENT_COOKIE="_gid=xxxxxxxxx; __RequestVerificationToken=xxxxxxxxx; _ga_XXX=xxxxxxxxxxxxxx"
TOURNAMENT_ORIGIN=https://melee.gg
OPENAI_API_KEY=(using AI for parsing of bulk data)
# Optional: tournament and private home-location geocoding. Never exposed to the frontend.
GEOAPIFY_API_KEY=
SENTRY_BACKEND_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.ingest.de.sentry.io/xxxxxxxxxxxxxxxxx
KARABAST_CLIENT_ID=asdf
KARABAST_CLIENT_SECRET=asdf
# Optional: creator credentials for Patreon subscriber/credits sync (server only).
# The client ID, client secret and refresh token renew access without a Patreon user login.
# Rotated tokens are stored encrypted in the database; env tokens seed the connection only.
# TOKEN_ENCRYPTION_KEY below must be stable and contain at least 32 characters.
# Store real values in .env; worktree tooling regenerates .env.worktree.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CREATORS_ACCESS_TOKEN=
PATREON_CREATORS_REFRESH_TOKEN=
# Copy the signing secret from the Patreon webhook configured for this environment.
# POST /api/integration/patreon/webhook; subscribe to all six members:* event types.
PATREON_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=a24e8722-a614-4a91-a165-6619cc86
SCREENSHOTTER_APP_BASE_URL=http://localhost:5173
SCREENSHOTTER_R2_PUBLIC_BASE_URL=https://images.swubase.com
SCREENSHOTTER_VIEWPORT_WIDTH=1440
SCREENSHOTTER_VIEWPORT_HEIGHT=1200
SCREENSHOTTER_DEVICE_SCALE_FACTOR=1
SCREENSHOTTER_TIMEOUT_MS=60000
SCREENSHOTTER_RUN_AFTER_IMPORT=false
DISCORD_TOURNAMENT_RESULTS_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_TOURNAMENT_RESULTS_CHANNEL_ID=
DISCORD_TOURNAMENT_RESULTS_ROLE_ID=
DISCORD_TOURNAMENT_STREAMS_CHANNEL_ID=
DISCORD_TOURNAMENT_STREAMS_ROLE_ID=
DISCORD_API_BASE_URL=https://discord.com/api/v10
DISCORD_TOURNAMENT_RESULTS_APP_BASE_URL=
# Shared app-link origin for results, streams, and resource submissions.
# Takes precedence over DISCORD_TOURNAMENT_RESULTS_APP_BASE_URL and auth origins.
DISCORD_APP_BASE_URL=
# Resource submissions: one forum post per resource, sent after saving for review.
# Set ENABLED=true on the backend, with DISCORD_BOT_TOKEN and DISCORD_APP_BASE_URL.
# Bot needs View Channel, Send Messages and Embed Links in the forum, and
# permission to mention the dev role (or make the role mentionable).
DISCORD_RESOURCE_SUBMISSIONS_ENABLED=false
# resource-submission forum: 1555341906811027546
DISCORD_RESOURCE_SUBMISSIONS_CHANNEL_ID=
# dev role: 1350878582532214784
DISCORD_RESOURCE_SUBMISSIONS_ROLE_ID=
# User reports: one private forum post per report, with the same role ping as
# resource submissions. Enable on the backend after configuring the bot.
DISCORD_USER_REPORTS_ENABLED=false
# user-reports forum: 1556212120612511795
DISCORD_USER_REPORTS_CHANNEL_ID=
# Private Crossfire bug reports: one forum post immediately after submission.
# Configure these and DISCORD_BOT_TOKEN on the game worker. No scheduled task.
DISCORD_CROSSFIRE_REPORTS_ENABLED=false
DISCORD_CROSSFIRE_REPORTS_CHANNEL_ID=
DISCORD_CROSSFIRE_REPORTS_APP_BASE_URL=
# Optional main-app OAuth provider; required on the separate MCP service.
# Main app and MCP MUST use the same canonical resource identifier.
MCP_RESOURCE_URL=
# MCP service only: existing Better Auth base URL, including /api/auth.
MCP_AUTH_ISSUER=
# MCP_HOST defaults to loopback locally; Dockerfile.mcp sets 0.0.0.0.
MCP_HOST=127.0.0.1
MCP_PORT=3210
MCP_CALLS_PER_MINUTE=60
# Optional comma-separated exact browser client origins; native clients need none.
MCP_ALLOWED_ORIGINS=
